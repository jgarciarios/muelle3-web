# Copiá este archivo a .env.local y completá con los valores reales
# del proyecto Supabase multi-tenant (jg-ventures-db).
# (Project Settings → API en el dashboard de supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SUPABASE_SERVICE_ROLE_KEY ---------------------------------------------
# NUNCA con prefijo NEXT_PUBLIC_. NUNCA commitear el valor real (este archivo
# es solo el ejemplo, .env.local está gitignoreado). Server-only: bypassea
# RLS por completo, así que solo se usa dentro de Server Actions / código
# server (ver src/lib/supabase/admin.ts, protegido con el import
# "server-only"). Si esta clave se filtra al bundle del cliente, cualquiera
# podría leer/escribir CUALQUIER dato de CUALQUIER restaurante en
# jg-ventures-db — tratala con la misma seriedad que una contraseña de
# base de datos.
SUPABASE_SERVICE_ROLE_KEY=
# ----------------------------------------------------------------------------

# Identifica a QUÉ restaurante pertenece este sitio, dentro de la base de
# datos compartida de la agencia (jg-ventures-db). Nunca lo define el
# usuario final — cada sitio de cliente tiene su propio valor fijo acá.
# Para Muelle 3: muelle-3
RESTAURANT_SLUG=muelle-3

# Google Place ID de este restaurante (público, no es un secreto — se puede
# sacar de cualquier link de Google Maps del lugar). Se usa para el botón
# "Dejá tu reseña" y, más adelante, para la Places API del carrusel de
# reseñas. Para Muelle 3: ChIJWXCHkPAFdZURHmmQYvcPoBU
NEXT_PUBLIC_GOOGLE_PLACE_ID=ChIJWXCHkPAFdZURHmmQYvcPoBU

# Número de WhatsApp del restaurante, en formato internacional, SIN "+" ni
# espacios ni guiones (ej. 59899123456). Se usa para el botón flotante de
# WhatsApp (src/components/whatsapp-button.tsx) y el botón "Escribinos por
# WhatsApp" de /contacto. Mientras esta var esté vacía, ninguno de los dos
# se renderiza (no se inventa un número).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Formulario de cotización de Eventos (/eventos) ------------------------
# Sin estas dos, la consulta se guarda igual en Supabase (eventos_consultas)
# pero NO se manda el aviso por mail — no rompe el formulario, solo no avisa.
# RESEND_API_KEY: cuenta gratuita en https://resend.com (API Keys).
# EVENTOS_NOTIFICATION_EMAIL: a qué mail llega el aviso de cada consulta.
RESEND_API_KEY=
EVENTOS_NOTIFICATION_EMAIL=
